# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# NEITHER of these is needed to reproduce the comparison table. The corpus
# snapshot, embedding cache and judgment cache are all committed, so
# `make reproduce` runs with no credentials, no network and no GPU.
# They are required only to REGENERATE those artifacts.

# Free token from https://www.courtlistener.com/
# Required only by `gt corpus fetch`. Opinion text returns 401 without it.
COURTLISTENER_API_TOKEN=

# Required only by `gt judge`, which regenerates generation-layer judgments.
# The regression gate never calls Anthropic.
ANTHROPIC_API_KEY=
