# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# NEITHER of these is needed to reproduce the comparison table. The corpus
# snapshot, embedding cache and judgment cache are all committed, so
# `make reproduce` runs with no credentials, no network and no GPU.
# They are required only to REGENERATE those artifacts.

# Free token from https://www.courtlistener.com/
# Required only by `gt corpus fetch`. Opinion text returns 401 without it.
COURTLISTENER_API_TOKEN=

# Required only by `gt judge`, which regenerates generation-layer judgments.
# The regression gate never calls Anthropic.
ANTHROPIC_API_KEY=

# --- LLM provider (candidate generation, and later the judge) ---------------
#
# Selection is EXPLICIT: `gt golden generate --provider azure`, or set
# GT_LLM_PROVIDER. There is no fallback chain -- a run answered by whichever
# vendor happened to be reachable would not be reproducible, and every
# candidate records the model that produced it.
#
# Fill in only the provider you intend to use.
GT_LLM_PROVIDER=anthropic

# Azure OpenAI. The DEPLOYMENT selects the model; the underlying model id
# comes back on the response and is what gets recorded. KEY2 is the rotation
# key -- an auth failure on the primary retries once on it.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_KEY2=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# OpenAI-compatible, bearer token. Model defaults per provider; override with
# <NAME>_MODEL or --model.
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

GEMINI_API_KEY=

# Local, no credential. Useful to rehearse the review loop for free; not
# recommended for the committed candidate set.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
